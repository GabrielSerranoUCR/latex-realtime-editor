# Settings for the deployment (in Coolify: the resource's Environment Variables). Never commit real values.

# Where the images are: ghcr.io/<owner>/<repository>, all lower case (the pipeline builds <that>/backend and <that>/frontend)
IMAGE_REPO=ghcr.io/owner/latex-realtime-editor
# Which build to run. `latest` follows main; a commit tag (sha-<40 hex>) pins one, and rolls back to it.
IMAGE_TAG=latest

# The database password (make a long random one)
POSTGRES_PASSWORD=

# The public address, with https:// and no trailing slash
QUILL_ALLOWED_ORIGIN=https://quill.example.com

# Optional: mail (invitations, password resets, magic links). Without it, mails are only written to the server's log.
# QUILL_SMTP_URL=smtps://user:password@smtp.example.com:465
# QUILL_MAIL_FROM=The Gilded Quill <noreply@example.com>
