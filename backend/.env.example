# quill-server configuration (all optional; defaults shown)
QUILL_PORT=8080
QUILL_DATABASE_URL=postgres://quill:quill@localhost:5434/quill   # docker compose up -d db
QUILL_DATA_DIR=./data                 # Yjs snapshots (docs/) and compiled PDFs (pdfs/)
QUILL_TECTONIC_BIN=tectonic           # path to the Tectonic CLI
QUILL_ALLOWED_ORIGIN=http://localhost:4200   # the ONLY origin allowed to make writes / open sockets
QUILL_COOKIE_SECURE=false             # MUST be true behind HTTPS in production
QUILL_SESSION_DAYS=30
QUILL_COMPILE_WORKERS=2               # concurrent compiles
QUILL_COMPILE_TIMEOUT_SECS=60
RUST_LOG=quill_server=info,tower_http=info

# --- added with account safety / storage ---
QUILL_PUBLIC_URL=http://localhost:4200  # where links in emails point
# QUILL_SMTP_URL=smtps://user:pass@smtp.example:587   # unset = mail is written to <data>/outbox
QUILL_MAIL_FROM="The Gilded Quill <noreply@localhost>"
QUILL_TRUST_PROXY=false               # true only behind a proxy you control (uses X-Forwarded-For)
QUILL_LOGIN_FAILURES_MAX=5            # failed sign-ins per email before a lockout
QUILL_LOGIN_WINDOW_MINUTES=15
QUILL_IP_AUTH_MAX=60                  # auth requests per IP per window
QUILL_MAX_ASSET_MB=25
QUILL_ASSET_QUOTA_MB=200
QUILL_VERSION_INTERVAL_MINUTES=10     # minimum gap between automatic version snapshots
